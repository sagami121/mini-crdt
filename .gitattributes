# Auto detect text files and perform LF normalization
* text=auto

# Rust files
*.rs text

# Cargo files
Cargo.toml text
Cargo.lock text

# Documentation
*.md text
*.txt text

# Configuration
*.toml text
*.json text
*.yaml text
*.yml text

# Shell scripts
*.sh text eol=lf

# Batch scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Benchmarks
benches/*.rs text